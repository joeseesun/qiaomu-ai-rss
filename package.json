{
  "name": "qiaomu-ai-rss",
  "version": "0.28.2",
  "description": "Read Qiaomu and personal RSS feeds, then add article links to your Daily Note.",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run && node --test server/*.check.cjs && node --test scripts/i18n-bundle.check.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "test:live": "node scripts/live-api.mjs"
  },
  "dependencies": {
    "@qiaomu/speech": "github:joeseesun/qiaomu-audio#e5999123f147d1590dd963e38cefe212d6c4f731",
    "dompurify": "^3.4.16",
    "lz-string": "1.5.0",
    "marked": "^18.0.11",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^26.4.1",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "fast-uri": "^3.1.8",
    "moment": "^2.31.0",
    "source-map-js": "^1.2.2"
  }
}
