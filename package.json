{
  "name": "qiaomu-ai-rss",
  "version": "0.9.0",
  "description": "Read Qiaomu and personal RSS feeds, then add article links to your Daily Note.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "test:live": "node scripts/live-api.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.11",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0"
  }
}
